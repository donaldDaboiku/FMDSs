# Required
MONGODB_URI=mongodb://localhost:27017/fmds
JWT_SECRET=replace-with-a-long-random-secret

# Server
PORT=5000
NODE_ENV=production

# Comma-separated origins allowed by CORS
# For single-host deploy (Express serves frontend), use your public site URL
# Example: https://fmds.example.com
CLIENT_ORIGIN=http://localhost:5000

# Optional rate limits (requests per 15 minutes)
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=40

# Set to false if frontend is hosted separately (Netlify/Vercel/etc.)
SERVE_CLIENT=true
